load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")
load("@rules_spring//springboot:springboot.bzl", "springboot")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")

# Kotlin microservice (fully migrated from Java)
kt_jvm_library(
    name = "artifact",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "//core:artifact",
        "//core:permissions_java_grpc",
        "//core:permissions_java_proto",
        "@maven//:com_auth0_auth0_spring_security_api",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:com_konghq_unirest_java_core",
        "@maven//:com_konghq_unirest_modules_jackson",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_netty_shaded",
        "@maven//:io_grpc_grpc_protobuf",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_micrometer_micrometer_core",
        "@maven//:io_micrometer_micrometer_tracing_bridge_brave",
        "@maven//:jakarta_persistence_jakarta_persistence_api",
        "@maven//:jakarta_transaction_jakarta_transaction_api",
        "@maven//:net_devh_grpc_server_spring_boot_starter",
        "@maven//:net_devh_grpc_spring_boot_starter",
        "@maven//:org_apache_tomcat_annotations_api",
        "@maven//:org_apache_tomcat_embed_tomcat_embed_core",
        "@maven//:org_hibernate_orm_hibernate_core",
        "@maven//:org_jetbrains_kotlin_kotlin_reflect",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_liquibase_liquibase_core",
        "@maven//:org_postgresql_postgresql",
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:org_springframework_boot_spring_boot_starter_data_jpa",
        "@maven//:org_springframework_boot_spring_boot_starter_security",
        "@maven//:org_springframework_boot_spring_boot_starter_web",
        "@maven//:org_springframework_data_spring_data_jpa",
        "@maven//:org_springframework_security_spring_security_config",
        "@maven//:org_springframework_security_spring_security_core",
        "@maven//:org_springframework_security_spring_security_oauth2_jose",
        "@maven//:org_springframework_security_spring_security_oauth2_resource_server",
        "@maven//:org_springframework_security_spring_security_web",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_spring_tx",
        "@maven//:org_springframework_spring_web",
    ],
)

springboot(
    name = "uber",
    boot_app_class = "com.gabriel.permissions.PermissionsApplicationKt",
    boot_launcher_class = "org.springframework.boot.loader.launch.JarLauncher",
    java_library = ":artifact",
    visibility = ["//visibility:public"],
)

tar(
    name = "layer",
    srcs = [
        ":uber.jar",
    ],
)

oci_image(
    name = "image",
    base = "@amazon_corretto_image",
    entrypoint = [
        "java",
        "-jar",
        "-Dspring.profiles.active=prod",
        "permissions/uber.jar",
    ],
    tars = [":layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "index.docker.io/gabrielmirandat/permissions",
)

# Unit tests
load("@contrib_rules_jvm//java:defs.bzl", "java_test_suite")

java_test_suite(
    name = "unit",
    size = "small",
    srcs = glob([
        "src/test/java/com/gabriel/permissions/application/**/*Test.java",
        "src/test/java/com/gabriel/permissions/domain/model/**/*Test.java",
    ]),
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":artifact",
        "//core:permissions_java_proto",
        "//core/src/main/java:model_lib",
        "@maven//:org_junit_jupiter_junit_jupiter",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_mockito_mockito_core",
        "@maven//:org_mockito_mockito_junit_jupiter",
        "@maven//:org_springframework_spring_core",
        "@maven//:org_springframework_security_spring_security_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
    ],
)

# Integration tests
java_test_suite(
    name = "integration",
    size = "large",
    srcs = glob(["src/test/java/com/gabriel/permissions/integration/**/*Test.java"]),
    runner = "junit5",
    runtime_deps = [
        "@maven//:org_junit_jupiter_junit_jupiter_engine",
        "@maven//:org_junit_platform_junit_platform_launcher",
        "@maven//:org_junit_platform_junit_platform_reporting",
    ],
    deps = [
        ":artifact",
        "@maven//:org_junit_jupiter_junit_jupiter",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
        "@maven//:org_springframework_boot_spring_boot_test",
        "@maven//:org_springframework_boot_spring_boot_test_autoconfigure",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_spring_test",
        "@maven//:org_testcontainers_testcontainers",
        "@maven//:org_testcontainers_junit_jupiter",
        "@maven//:org_testcontainers_postgresql",
    ],
)
