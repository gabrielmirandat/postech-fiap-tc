## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
build_output/

# Visual Studio cache/options directory
.vs/

# Rider
.idea/

# .NET Core
project.lock.json
project.fragment.lock.json
artifacts/
*.dll
*.pdb
*.exe
*.cache

# NuGet Packages
*.nupkg
*.snupkg
**/packages/*
**/packages/
project.assets.json
project.nuget.cache
*.nuget.props
*.nuget.targets
*.dgspec.json

# Visual Studio cache files
*.cachefile
*.VC.db
*.VC.VC.opendb

# Test results
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.coverage
*.coveragexml

# .NET Core publish
publish/
*.pubxml
*.publishproj

# macOS
.DS_Store

# Bazel
bazel-*
bazel-out/
bazel-bin/
bazel-testlogs/

# JetBrains Rider
.idea/
*.sln.iml

# VS Code
.vscode/

# Local configuration files
appsettings.local.json
appsettings.*.local.json
*.local.json
