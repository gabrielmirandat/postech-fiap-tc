# core/BUILD

load("@rules_java//java:defs.bzl", "java_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "proto_menu_deps",
    srcs = ["src/main/java/com/gabriel/specs/menu/menu-api.proto"],
    deps = [
        "@com_google_protobuf//:timestamp_proto"
    ],
)

java_proto_library(
    name = "proto_menu",
    visibility = ["//visibility:public"],
    deps = [":proto_menu_deps"],
)

proto_library(
    name = "proto_permissions_deps",
    srcs = ["src/main/java/com/gabriel/specs/permissions/permissions-api.proto"],
    deps = [
        "@com_google_protobuf//:timestamp_proto"
    ],
)

java_proto_library(
    name = "proto_permissions",
    visibility = ["//visibility:public"],
    deps = [":proto_permissions_deps"],
)

load("@rules_java//java:defs.bzl", "java_library")

java_library(
    name = "artifact",
    visibility = ["//visibility:public"],
    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]),
    javacopts = ["-source", "21", "-target", "21"],
    deps = [
        ":proto_menu",
        ":proto_permissions",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:jakarta_persistence_jakarta_persistence_api",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
    ],
)

load("@rules_jvm_external//:defs.bzl", "artifact")
load("@contrib_rules_jvm//java:defs.bzl", "JUNIT5_DEPS", "java_test_suite")

java_test_suite(
    name = "unit",
    srcs = glob(["src/test/unit/java/**/*.java"]),
    runner = "junit5",
    javacopts = ["-source", "21", "-target", "21"],
    resources = glob(["src/test/resources/**"]),
    runtime_deps = JUNIT5_DEPS,
    deps = [
        ":artifact",
        "@maven//:org_glassfish_expressly_expressly",
        "@maven//:org_hibernate_validator_hibernate_validator_cdi",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)