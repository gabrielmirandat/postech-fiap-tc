# Buf toolchain
buf = use_extension("@rules_buf//buf:extensions.bzl", "buf")
buf.toolchains(version = "v1.50.0")
buf.dependency(module = "buf.build/googleapis/googleapis:61b203b9a9164be9a834f58c37be6f62")
buf.dependency(module = "buf.build/bufbuild/protovalidate:6c6e0d3c608e4549802254a2eee81bc8")
use_repo(buf, "buf_deps")
use_repo(buf, "rules_buf_toolchains")

# OCI toolchain
oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "dotnet_aspnet_8_0",
    image = "mcr.microsoft.com/dotnet/aspnet",
    platforms = ["linux/amd64"],
    tag = "8.0",
)
oci.pull(
    name = "amazon_corretto_image",
    image = "public.ecr.aws/docker/library/amazoncorretto",
    platforms = ["linux/amd64"],
    tag = "21",
)
oci.pull(
    name = "ruby_3_2_0_image",
    image = "docker.io/library/ruby",
    platforms = ["linux/amd64"],
    tag = "3.2.0-slim",
)
use_repo(oci, "amazon_corretto_image", "amazon_corretto_image_linux_amd64", "dotnet_aspnet_8_0", "dotnet_aspnet_8_0_linux_amd64", "ruby_3_2_0_image", "ruby_3_2_0_image_linux_amd64")

# OpenAPI generator
openapi_gen = use_extension("@openapi_tools_generator_bazel//:extension.bzl", "openapi_gen")
openapi_gen.client(
    sha256 = "01387c73905de47a6ecf8801f91c8d61624f8a1e890c8058225df51d493bc32a",
    version = "7.0.1",
)
use_repo(openapi_gen, "openapi_tools_generator_bazel_cli")

# Python toolchain - hermetic Python builds
python = use_extension("@rules_python//python:extensions.bzl", "python")
python.toolchain(
    python_version = "3.11",
    configure_coverage_tool = True,
)
use_repo(python, "python3_11_toolchains", "python_versions")

# .NET toolchain - hermetic .NET builds
dotnet = use_extension("@rules_dotnet//dotnet:extensions.bzl", "dotnet")
dotnet.toolchain(dotnet_version = "8.0.100")
use_repo(dotnet, "dotnet_toolchains")
register_toolchains("@dotnet_toolchains//:all")

# Ruby toolchain - hermetic Ruby builds
ruby = use_extension("@rules_ruby//ruby:extensions.bzl", "ruby")
ruby.toolchain(
    name = "ruby_3_2_0",
    version = "3.2.0",
)
use_repo(ruby, "ruby_3_2_0")
