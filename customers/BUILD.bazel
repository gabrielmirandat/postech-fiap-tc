load("@rules_python//python:defs.bzl", "py_binary", "py_library")

package(default_visibility = ["//visibility:public"])

# Build target - just creates a marker
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
)

# Required installations (runs EdgeDB CLI and OpenAPI Generator)
genrule(
    name = "install_edgedb",
    outs = ["edgedb_installed"],
    cmd = "pip install edgedb && touch $@",
)

genrule(
    name = "install_openapi_generator",
    outs = ["openapi_generator_installed"],
    cmd = "pip install openapi-python-client && touch $@",
)

# OpenAPI objects generation
genrule(
    name = "generate_openapi_client",
    srcs = ["openapi.yaml"],
    outs = ["openapi_client/__init__.py"],
    cmd = "openapi-python-client generate --path $< --output openapi_client",
    tools = [":install_openapi_generator"],
)

# EdgeDB database migration and creation
genrule(
    name = "edgedb_migrate",
    srcs = ["db/migrations/*.esdl"],
    outs = ["migrations_applied"],
    cmd = "edgedb project init && edgedb migrate && touch $@",
    tools = [":install_edgedb"],
)

# Python libraries for each module with dependencies
py_library(
    name = "entities",
    srcs = glob(["src/entities/**/*.py"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "db",
    srcs = glob(["src/db/**/*.py"]),
    deps = [
        ":entities",
        ":config",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "devices",
    srcs = glob(["src/devices/**/*.py"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "gateways",
    srcs = glob(["src/gateways/**/*.py"]),
    deps = [
        ":entities",
        ":db",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "presenters",
    srcs = glob(["src/presenters/**/*.py"]),
    deps = [
        ":entities",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "use_cases",
    srcs = glob(["src/use_cases/**/*.py"]),
    deps = [
        ":entities",
        ":gateways",
        ":devices",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "controllers",
    srcs = glob(["src/controllers/**/*.py"]),
    deps = [
        ":use_cases",
        ":presenters",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "external_interfaces",
    srcs = glob(["src/external_interfaces/**/*.py"]),
    deps = [
        ":use_cases",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "web",
    srcs = glob(["src/web/**/*.py"]),
    deps = [
        ":use_cases",
        ":entities",
        ":containers",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "config",
    srcs = [
        "src/config.py",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "containers",
    srcs = [
        "src/containers.py",
    ],
    deps = [
        ":config",
        ":controllers",
        ":db",
        ":devices",
        ":external_interfaces",
        ":gateways",
        ":use_cases",
    ],
    visibility = ["//visibility:public"],
)

# Executable - ready to run
py_binary(
    name = "uber",
    srcs = [
        "src/main.py",
    ],
    main = "src/main.py",
    deps = [
        ":config",
        ":containers",
        ":controllers",
        ":db",
        ":devices",
        ":entities",
        ":external_interfaces",
        ":gateways",
        ":presenters",
        ":use_cases",
        ":web",
    ],
    visibility = ["//visibility:public"],
)