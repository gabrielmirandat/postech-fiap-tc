load("@rules_dotnet//dotnet:defs.bzl", "csharp_binary", "csharp_library")
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# NuGet dependencies are loaded via module_extension in MODULE.bazel
# Run ./update-deps.sh to regenerate paket.dependencies.bzl

# Domain layer - no external dependencies
csharp_library(
    name = "domain",
    srcs = glob([
        "Payments.Domain/**/*.cs",
    ], exclude = [
        "**/obj/**",
        "**/bin/**",
    ]),
    target_frameworks = ["net10.0"],
    visibility = ["//visibility:public"],
)

# Application layer - depends on Domain
csharp_library(
    name = "application",
    srcs = glob([
        "Payments.Application/**/*.cs",
    ], exclude = [
        "**/obj/**",
        "**/bin/**",
    ]),
    deps = [
        ":domain",
        "@paket.main//mediatr:mediatr",
        "@paket.main//mediatr.contracts:mediatr.contracts",
        "@paket.main//fluentvalidation:fluentvalidation",
        "@paket.main//fluentvalidation.dependencyinjectionextensions:fluentvalidation.dependencyinjectionextensions",
    ],
    target_frameworks = ["net10.0"],
    visibility = ["//visibility:public"],
)

# Infrastructure layer - depends on Domain and Application
csharp_library(
    name = "infrastructure",
    srcs = glob([
        "Payments.Infrastructure/**/*.cs",
    ], exclude = [
        "**/obj/**",
        "**/bin/**",
    ]),
    deps = [
        ":domain",
        ":application",
        "@paket.main//mediatr:mediatr",
        "@paket.main//cassandracsharpdriver:cassandracsharpdriver",
        "@paket.main//stripe.net:stripe.net",
        "@paket.main//confluent.kafka:confluent.kafka",
        "@paket.main//microsoft.extensions.configuration:microsoft.extensions.configuration",
        "@paket.main//microsoft.extensions.configuration.abstractions:microsoft.extensions.configuration.abstractions",
        "@paket.main//microsoft.extensions.dependencyinjection:microsoft.extensions.dependencyinjection",
        "@paket.main//microsoft.extensions.dependencyinjection.abstractions:microsoft.extensions.dependencyinjection.abstractions",
        "@paket.main//microsoft.extensions.logging:microsoft.extensions.logging",
        "@paket.main//microsoft.extensions.logging.abstractions:microsoft.extensions.logging.abstractions",
    ],
    target_frameworks = ["net10.0"],
    visibility = ["//visibility:public"],
)

# Build target - marker for artifact
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
)

# Unit tests - placeholder
genrule(
    name = "unit",
    outs = ["unit_test_results"],
    cmd = "echo 'Unit tests placeholder' > $@",
    testonly = True,
    local = 1,
)

# Integration tests - placeholder
genrule(
    name = "integration",
    outs = ["integration_test_results"],
    cmd = "echo 'Integration tests placeholder' > $@",
    testonly = True,
    local = 1,
)

# API executable - ready to run (no Docker required)
csharp_binary(
    name = "uber",
    srcs = glob([
        "Payments.Api/**/*.cs",
    ], exclude = [
        "**/obj/**",
        "**/bin/**",
        "**/Payments.API/**",  # Exclude duplicate API folder
    ]),
    deps = [
        ":domain",
        ":application",
        ":infrastructure",
        "@paket.main//mediatr:mediatr",
        "@paket.main//mediatr.contracts:mediatr.contracts",
        "@paket.main//microsoft.aspnetcore:microsoft.aspnetcore",
        "@paket.main//microsoft.aspnetcore.hosting:microsoft.aspnetcore.hosting",
        "@paket.main//microsoft.aspnetcore.hosting.abstractions:microsoft.aspnetcore.hosting.abstractions",
        "@paket.main//microsoft.aspnetcore.http.abstractions:microsoft.aspnetcore.http.abstractions",
        "@paket.main//microsoft.aspnetcore.routing:microsoft.aspnetcore.routing",
        "@paket.main//microsoft.aspnetcore.mvc.core:microsoft.aspnetcore.mvc.core",
        "@paket.main//microsoft.aspnetcore.mvc.abstractions:microsoft.aspnetcore.mvc.abstractions",
        "@paket.main//grpc.aspnetcore:grpc.aspnetcore",
        "@paket.main//microsoft.extensions.logging:microsoft.extensions.logging",
        "@paket.main//microsoft.extensions.logging.abstractions:microsoft.extensions.logging.abstractions",
        "@paket.main//microsoft.extensions.hosting:microsoft.extensions.hosting",
        "@paket.main//microsoft.extensions.configuration.abstractions:microsoft.extensions.configuration.abstractions",
        "@paket.main//microsoft.extensions.dependencyinjection.abstractions:microsoft.extensions.dependencyinjection.abstractions",
    ],
    target_frameworks = ["net10.0"],
    appsetting_files = [
        "Payments.Api/appsettings.json",
        "Payments.Api/appsettings.Development.json",
    ],
    visibility = ["//visibility:public"],
)

# Layer for Docker image
tar(
    name = "layer",
    srcs = [
        ":uber",
    ],
)

# Docker image - for deployment only (Docker required)
oci_image(
    name = "image",
    base = "@dotnet_aspnet_10_0",
    entrypoint = [
        "dotnet",
        "payments/uber.exe",
    ],
    tars = [":layer"],
)

# Push to Docker Hub
oci_push(
    name = "push",
    image = ":image",
    repository = "index.docker.io/gabrielmirandat/payments",
    remote_tags = ["latest"],
)
