load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# Build target - just creates a marker
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
)

# Unit tests - using sh_test to run Rails tests
sh_test(
    name = "unit",
    srcs = ["test_runner.sh"],
    data = glob([
        "**/*.rb",
        "**/*.yml",
        "Gemfile",
        "Gemfile.lock",
    ]),
    size = "medium",
    timeout = "moderate",
)

# Integration tests - placeholder
genrule(
    name = "integration",
    outs = ["integration_test_marker"],
    cmd = "touch $@",
    testonly = True,
    local = 1,
)

# Executable - ready to run (Docker image)
oci_image(
    name = "uber",
    base = "@ruby_3_2_0",
    entrypoint = ["bundle", "exec", "puma", "-C", "config/puma.rb"],
    env = {
        "RAILS_ENV": "production",
        "PORT": "8005",
        "POSTGRES_HOST": "postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "dummy",
        "POSTGRES_PASSWORD": "dummy",
        "POSTGRES_DB": "postech_db",
        "KAFKA_SERVER_URL": "kafka:29092",
        "KAFKA_NOTIFICATIONS_TOPIC": "notifications",
    },
    tars = [":notifications_files"],
)

# Create tar with application files
genrule(
    name = "notifications_files",
    srcs = glob([
        "**/*.rb",
        "**/*.yml",
        "Gemfile",
        "Gemfile.lock",
        "Dockerfile",
    ]) + glob([
        "**/*.yaml",
    ], allow_empty = True),
    outs = ["notifications.tar"],
    cmd = """
    tar -czf $@ -C $$(dirname $(location Gemfile)) .
    """,
)

# Push to Docker Hub
oci_push(
    name = "push",
    image = ":uber",
    remote_tags = ["gabrielmirandat/notifications:latest"],
)
