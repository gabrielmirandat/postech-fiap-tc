load("@rules_ruby//ruby:defs.bzl", "rb_library", "rb_binary", "rb_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# Rails application library
rb_library(
    name = "app",
    srcs = glob([
        "app/**/*.rb",
        "config/**/*.rb",
    ]),
    deps = [
        "@bundle//:bundle",
    ],
    visibility = ["//visibility:public"],
)

# Rails executable (puma server)
rb_binary(
    name = "uber",
    main = "config.ru",
    deps = [
        ":app",
        "@bundle//:bundle",
    ],
    args = [
        "-C",
        "config/puma.rb",
    ],
    visibility = ["//visibility:public"],
)

# Build target - marker
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
)

# Unit tests - using rb_test
rb_test(
    name = "unit",
    srcs = glob([
        "spec/**/*_spec.rb",
    ], allow_empty = True),
    deps = [
        ":app",
        "@bundle//:bundle",
    ],
    size = "medium",
    timeout = "moderate",
)

# Integration tests - placeholder
genrule(
    name = "integration",
    outs = ["integration_test_marker"],
    cmd = "touch $@",
    testonly = True,
    local = 1,
)

# Docker image - for deployment
oci_image(
    name = "image",
    base = "@ruby_3_2_0_image",
    entrypoint = ["bundle", "exec", "puma", "-C", "config/puma.rb"],
    env = {
        "RAILS_ENV": "production",
        "PORT": "8005",
        "POSTGRES_HOST": "postgres",
        "POSTGRES_PORT": "5432",
        "POSTGRES_USER": "dummy",
        "POSTGRES_PASSWORD": "dummy",
        "POSTGRES_DB": "postech_db",
        "KAFKA_SERVER_URL": "kafka:29092",
        "KAFKA_NOTIFICATIONS_TOPIC": "notifications",
    },
    tars = [":notifications_files"],
)

# Create tar with application files
genrule(
    name = "notifications_files",
    srcs = glob([
        "**/*.rb",
        "**/*.yml",
        "Gemfile",
        "Gemfile.lock",
    ]) + glob([
        "**/*.yaml",
    ], allow_empty = True),
    outs = ["notifications.tar"],
    cmd = """
    tar -czf $@ -C $$(dirname $(location Gemfile)) .
    """,
)

# Push to Docker Hub
oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["gabrielmirandat/notifications:latest"],
)
