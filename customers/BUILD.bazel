load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# Build target - just creates a marker
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
)

# NOTE: EdgeDB CLI and OpenAPI Generator are now managed hermetically via @pip//
# If needed, create py_binary targets that use @pip//edgedb and @pip//openapi_python_client
# For now, these genrules are removed as they used non-hermetic pip install

# Python libraries for each module with dependencies
py_library(
    name = "entities",
    srcs = glob(["src/entities/**/*.py"]),
    visibility = ["//visibility:public"],
)

py_library(
    name = "db",
    srcs = glob(["src/db/**/*.py"]),
    deps = [
        ":entities",
        ":config",
        "@pip//edgedb",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "devices",
    srcs = glob(["src/devices/**/*.py"]),
    deps = [
        "@pip//aiokafka",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "gateways",
    srcs = glob(["src/gateways/**/*.py"]),
    deps = [
        ":entities",
        ":db",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "presenters",
    srcs = glob(["src/presenters/**/*.py"]),
    deps = [
        ":entities",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "use_cases",
    srcs = glob(["src/use_cases/**/*.py"]),
    deps = [
        ":entities",
        ":gateways",
        ":devices",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "controllers",
    srcs = glob(["src/controllers/**/*.py"]),
    deps = [
        ":use_cases",
        ":presenters",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "external_interfaces",
    srcs = glob(["src/external_interfaces/**/*.py"]),
    deps = [
        ":use_cases",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "web",
    srcs = glob(["src/web/**/*.py"]),
    deps = [
        ":use_cases",
        ":entities",
        ":containers",
        "@pip//fastapi",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "config",
    srcs = [
        "src/config.py",
    ],
    visibility = ["//visibility:public"],
)

py_library(
    name = "containers",
    srcs = [
        "src/containers.py",
    ],
    deps = [
        ":config",
        ":controllers",
        ":db",
        ":devices",
        ":external_interfaces",
        ":gateways",
        ":use_cases",
        "@pip//dependency_injector",
    ],
    visibility = ["//visibility:public"],
)

# Executable - ready to run
py_binary(
    name = "uber",
    srcs = [
        "src/main.py",
    ],
    main = "src/main.py",
    deps = [
        ":config",
        ":containers",
        ":controllers",
        ":db",
        ":devices",
        ":entities",
        ":external_interfaces",
        ":gateways",
        ":presenters",
        ":use_cases",
        ":web",
        # Hermetic Python dependencies
        "@pip//fastapi",
        "@pip//uvicorn",
        "@pip//edgedb",
        "@pip//kafka_python",
        "@pip//aiokafka",
        "@pip//dependency_injector",
    ],
    visibility = ["//visibility:public"],
)

# Tar layer for OCI image
tar(
    name = "layer",
    srcs = [":uber"],
)

# OCI image target
oci_image(
    name = "image",
    base = "@python_3_11_slim",
    entrypoint = [
        "python",
        "-m",
        "uvicorn",
        "src.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
    ],
    tars = [":layer"],
    labels = {
        "org.opencontainers.image.source": "https://github.com/gabrielmirandat/postech-fiap-tc",
        "org.opencontainers.image.description": "Customers microservice - FastAPI + EdgeDB",
        "org.opencontainers.image.licenses": "MIT",
    },
)

# OCI push target for Docker Hub
oci_push(
    name = "push",
    image = ":image",
    repository = "index.docker.io/gabrielmirandat/customers",
    remote_tags = ["latest"],
)