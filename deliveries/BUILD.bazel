load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library")
load("@crate_index//:defs.bzl", "all_crate_deps")
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# Build artifact marker
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
    visibility = ["//visibility:public"],
)

# Rust library
rust_library(
    name = "deliveries_lib",
    srcs = glob(["src/**/*.rs"], exclude = ["src/main.rs"]),
    edition = "2021",
    deps = all_crate_deps(),
)

# Rust binary
rust_binary(
    name = "uber",
    srcs = ["src/main.rs"],
    edition = "2021",
    deps = [
        ":deliveries_lib",
    ] + all_crate_deps(),
    visibility = ["//visibility:public"],
)

# Tar layer for OCI image
tar(
    name = "layer",
    srcs = [":uber"],
)

# OCI image target
oci_image(
    name = "image",
    base = "@debian_12_slim",
    entrypoint = ["/deliveries/uber"],
    tars = [":layer"],
    labels = {
        "org.opencontainers.image.source": "https://github.com/gabrielmirandat/postech-fiap-tc",
        "org.opencontainers.image.description": "Deliveries microservice - Rust/Axum",
        "org.opencontainers.image.licenses": "MIT",
    },
)

# OCI push target for Docker Hub
oci_push(
    name = "push",
    image = ":image",
    repository = "index.docker.io/gabrielmirandat/deliveries",
    remote_tags = ["latest"],
)
