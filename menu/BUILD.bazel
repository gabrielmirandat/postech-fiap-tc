# Quarkus uber JAR - generates executable quarkus-run.jar
# Using Maven in Docker for reliable builds
load("//_tools/rules_quarkus/quarkus:quarkus.bzl", "quarkus_maven")

# Quarkus uber JAR using Maven in Docker (recommended - we know it works)
# Include OpenAPI generated files and core module dependencies
quarkus_maven(
    name = "uber",
    java_library = ":artifact",
    pom_xml = "pom.xml",
    source_files = glob(["src/main/java/**/*.java"]),
    resource_files = glob(["src/main/resources/**"]),
    deps = [
        ":menu_api",  # Include menu_api JAR to extract generated classes
        ":menu_api_jar",  # Include menu_api.srcjar to extract source files
        "//core/src/main/java:model_lib",  # Core model library
        "//core/src/main/java:model_java_jar",  # Core model proto source JAR
        "//core/src/main/java:menu_java_grpc",
        "//core/src/main/java:menu_java_proto",
        "//core/src/main/java:permissions_java_grpc",
        "//core/src/main/java:permissions_java_proto",
    ],
    visibility = ["//visibility:public"],
)


# Extract quarkus-app from the ZIP generated by quarkus_maven
genrule(
    name = "quarkus_app_extracted",
    srcs = [":uber"],
    outs = ["menu_quarkus_app_marker"],
    cmd = """
set -e
TMPDIR=$$(mktemp -d)
trap "rm -rf $$TMPDIR" EXIT
unzip -q $(location :uber) -d $$TMPDIR
mkdir -p $(@D)/menu
# Move quarkus-app/ into menu/
if [ -d "$$TMPDIR/quarkus-app" ]; then
  mv $$TMPDIR/quarkus-app $(@D)/menu/
  echo "quarkus-app extracted" > $@
else
  echo "Error: quarkus-app directory not found in ZIP" >&2
  exit 1
fi
""",
)

# Create a filegroup that includes both the marker and the extracted directory
filegroup(
    name = "quarkus_app_files",
    srcs = [
        ":quarkus_app_extracted",
        ":uber",
    ],
)

tar(
    name = "layer",
    srcs = [
        ":quarkus_app_files",
    ],
)

oci_image(
    name = "image",
    base = "@amazon_corretto_image",
    entrypoint = [
        "sh",
        "-c",
        "cd menu/quarkus-app && java -jar quarkus-run.jar",
    ],
    tars = [":layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "index.docker.io/gabrielmirandat/menu",
)

