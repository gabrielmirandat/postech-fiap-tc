load("@rules_jvm_external//:defs.bzl", "artifact")
load("@openapi_tools_generator_bazel//:defs.bzl", "openapi_generator")

java_import(
    name = "newrelic",
    jars = ["@newrelic_java//:newrelic.jar"],
    visibility = ["//visibility:public"],
)

openapi_generator(
    name = "orders_api_files",
    spec = "src/main/resources/oas/orders-api.yaml",
    generator = "spring",
    config = "config.yml"
)

genrule(
    name = "orders_api_jar",
    srcs = [":orders_api_files"],
    outs = ["orders_api.srcjar"],
    tools = ["@bazel_tools//tools/zip:zipper"],
    cmd = """
    files=$$(find -L $(location :orders_api_files)/src/main/java -type f)
    zipper_args=()
    for f in $${files[@]}; do
    path_in_zip="$${f/bazel-out\\/k8-fastbuild\\/bin\\/orders_api_files\\/src\\/main\\/java\\//}"
    zipper_args+=("$$path_in_zip=$$f")
    done
    $(location @bazel_tools//tools/zip:zipper) c $@ $${zipper_args[@]}
    """,
)

java_library(
    name = "orders_api",
    srcs = [":orders_api.srcjar"],
    deps = [
        "@maven//:io_swagger_core_v3_swagger_annotations",
        "@maven//:jakarta_validation_jakarta_validation_api",
        "@maven//:jakarta_annotation_jakarta_annotation_api",
        "@maven//:org_apache_tomcat_embed_tomcat_embed_core",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_web",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
    ],
)

