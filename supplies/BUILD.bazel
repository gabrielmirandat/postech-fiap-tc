load("@aspect_rules_ts//ts:defs.bzl", "ts_project")
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("@npm//:defs.bzl", "npm_link_all_packages")
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# Build artifact marker
genrule(
    name = "artifact",
    outs = ["artifact_marker"],
    cmd = "touch $@",
    visibility = ["//visibility:public"],
)

# Link all npm packages from pnpm-lock.yaml
npm_link_all_packages(name = "node_modules")

# Compile TypeScript sources
ts_project(
    name = "supplies_ts",
    srcs = glob([
        "src/**/*.ts",
    ]),
    declaration = True,
    incremental = True,
    out_dir = "dist",
    resolve_json_module = True,
    source_map = True,
    transpiler = "tsc",
    tsconfig = "tsconfig.json",
    validate = False,
    deps = [
        "//supplies:node_modules/@nestjs/common",
        "//supplies:node_modules/@nestjs/config",
        "//supplies:node_modules/@nestjs/core",
        "//supplies:node_modules/@nestjs/microservices",
        "//supplies:node_modules/@nestjs/platform-express",
        "//supplies:node_modules/@nestjs/swagger",
        "//supplies:node_modules/@types/node",
        "//supplies:node_modules/class-transformer",
        "//supplies:node_modules/class-validator",
        "//supplies:node_modules/reflect-metadata",
        "//supplies:node_modules/rxjs",
    ],
)

# Create executable binary
js_binary(
    name = "uber",
    data = [
        ":supplies_ts",
        "//supplies:node_modules/@nestjs/common",
        "//supplies:node_modules/@nestjs/config",
        "//supplies:node_modules/@nestjs/core",
        "//supplies:node_modules/@nestjs/microservices",
        "//supplies:node_modules/@nestjs/platform-express",
        "//supplies:node_modules/@nestjs/swagger",
        "//supplies:node_modules/class-transformer",
        "//supplies:node_modules/class-validator",
        "//supplies:node_modules/reflect-metadata",
        "//supplies:node_modules/rxjs",
    ],
    entry_point = "dist/src/main.js",
)

# Tar layer for OCI image
# Note: Disabled in CI/CD due to symlink issues with pnpm node_modules
# Can be built manually with: bazel build //supplies:layer
tar(
    name = "layer",
    srcs = [":uber"],
    tags = ["manual"],
)

# OCI image target
# Note: Disabled in CI/CD due to tar layer symlink issues
# Can be built manually with: bazel build //supplies:image
oci_image(
    name = "image",
    base = "@nodejs_image",
    entrypoint = [
        "node",
        "/supplies/uber_/uber",
    ],
    tars = [":layer"],
    tags = ["manual"],
    labels = {
        "org.opencontainers.image.source": "https://github.com/gabrielmirandat/postech-fiap-tc",
        "org.opencontainers.image.description": "Supplies microservice - TypeScript/NestJS",
        "org.opencontainers.image.licenses": "MIT",
    },
)

# OCI push target for Docker Hub
oci_push(
    name = "push",
    image = ":image",
    repository = "index.docker.io/gabrielmirandat/supplies",
    remote_tags = ["latest"],
    tags = ["manual"],
)
