load("@rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "server_lib",
    srcs = ["main.go"],
    importpath = "github.com/gabriel/menu/cmd/server",
    visibility = ["//menu:__pkg__", "//menu:__subpackages__"],
    deps = [
        "//menu/internal/adapter/http",
        "//menu/internal/adapter/messaging",
        "//menu/internal/adapter/repository",
        "//menu/internal/application",
        "//menu/internal/config",
        "@com_github_gin_gonic_gin//:gin",
        "@org_mongodb_go_mongo_driver//mongo",
        "@org_mongodb_go_mongo_driver//mongo/options",
    ],
)

go_binary(
    name = "server",
    embed = [":server_lib"],
    visibility = ["//visibility:public"],
)
