load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

# Kotlin library (used by Quarkus Maven build and by tests)
kt_jvm_library(
    name = "artifact",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    resources = glob(["src/main/resources/**"]),
    visibility = ["//visibility:public"],
    deps = [
        "//core:artifact",
        "//core:permissions_java_grpc",
        "//core:permissions_java_proto",
        "@maven//:com_fasterxml_jackson_core_jackson_annotations",
        "@maven//:com_fasterxml_jackson_core_jackson_core",
        "@maven//:com_fasterxml_jackson_core_jackson_databind",
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:com_konghq_unirest_java_core",
        "@maven//:com_konghq_unirest_modules_jackson",
        "@maven//:io_grpc_grpc_api",
        "@maven//:io_grpc_grpc_protobuf",
        "@maven//:io_grpc_grpc_stub",
        "@maven//:io_quarkus_quarkus_kotlin",
        "@maven//:io_quarkus_quarkus_resteasy",
        "@maven//:io_quarkus_quarkus_resteasy_jackson",
        "@maven//:io_quarkus_quarkus_hibernate_orm",
        "@maven//:io_quarkus_quarkus_hibernate_orm_panache",
        "@maven//:io_quarkus_quarkus_jdbc_postgresql",
        "@maven//:io_quarkus_quarkus_liquibase",
        "@maven//:io_quarkus_quarkus_oidc",
        "@maven//:io_quarkus_quarkus_security",
        "@maven//:io_quarkus_quarkus_grpc",
        "@maven//:io_quarkus_quarkus_smallrye_health",
        "@maven//:jakarta_persistence_jakarta_persistence_api",
        "@maven//:org_jetbrains_kotlin_kotlin_reflect",
        "@maven//:org_jetbrains_kotlin_kotlin_stdlib",
        "@maven//:org_liquibase_liquibase_core",
        "@maven//:org_postgresql_postgresql",
    ],
)

# Quarkus build via Maven (same pattern as menu)
load("//_tools/rules_quarkus/quarkus:quarkus.bzl", "quarkus_maven", "quarkus_maven_test")

# Same pattern as menu/orders: depend on core at lib generation and add Java sources
# (model_java_jar = srcjar so genrule extracts .java to workspace; no com.gabriel:core in pom)
quarkus_maven(
    name = "uber",
    java_library = ":artifact",
    pom_xml = "pom.xml",
    source_files = glob(["src/main/kotlin/**/*.kt"]),
    resource_files = glob(["src/main/resources/**"]),
    deps = [
        "//core/src/main/java:model_lib",
        "//core/src/main/java:model_java_jar",
        "//core/src/main/java:permissions_java_grpc",
        "//core/src/main/java:permissions_java_proto",
    ],
    visibility = ["//visibility:public"],
)

# bazel test //permissions:unit (Maven + JUnit 5 in Docker; one Bazel test per class, same as integration)
quarkus_maven_test(
    name = "unit",
    java_library = ":artifact",
    pom_xml = "pom.xml",
    source_files = glob(["src/main/kotlin/**/*.kt"]),
    resource_files = glob(["src/main/resources/**"]),
    test_source_files = glob(["src/test/unit/kotlin/**/*.kt"]),
    test_resource_files = glob(["src/test/resources/**"]),
    deps = [
        "//core/src/main/java:model_lib",
        "//core/src/main/java:model_java_jar",
        "//core/src/main/java:permissions_java_grpc",
        "//core/src/main/java:permissions_java_proto",
    ],
    tags = ["requires-docker", "local"],
)

# bazel test //permissions:integration (Quarkus @QuarkusTest, one Bazel test per class; like orders:integration)
quarkus_maven_test(
    name = "integration",
    java_library = ":artifact",
    pom_xml = "pom.xml",
    source_files = glob(["src/main/kotlin/**/*.kt"]),
    resource_files = glob(["src/main/resources/**"]),
    test_source_files = glob(["src/test/integration/kotlin/**/*.kt"]),
    test_resource_files = glob(["src/test/resources/**"]),
    deps = [
        "//core/src/main/java:model_lib",
        "//core/src/main/java:model_java_jar",
        "//core/src/main/java:permissions_java_grpc",
        "//core/src/main/java:permissions_java_proto",
    ],
    tags = ["requires-docker", "local"],
)

# Extract quarkus-app from the ZIP (same as menu)
genrule(
    name = "quarkus_app_extracted",
    srcs = [":uber"],
    outs = ["permissions_quarkus_app_marker"],
    cmd = """
set -e
TMPDIR=$$(mktemp -d)
trap "rm -rf $$TMPDIR" EXIT
unzip -q $(location :uber) -d $$TMPDIR
mkdir -p $(@D)/permissions
if [ -d "$$TMPDIR/quarkus-app" ]; then
  mv $$TMPDIR/quarkus-app $(@D)/permissions/
  echo "quarkus-app extracted" > $@
else
  echo "Error: quarkus-app directory not found in ZIP" >&2
  exit 1
fi
""",
)

filegroup(
    name = "quarkus_app_files",
    srcs = [
        ":quarkus_app_extracted",
        ":uber",
    ],
)

tar(
    name = "layer",
    srcs = [":quarkus_app_files"],
)

oci_image(
    name = "image",
    base = "@amazon_corretto_image",
    entrypoint = [
        "sh",
        "-c",
        "cd permissions/quarkus-app && java -jar quarkus-run.jar",
    ],
    tars = [":layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "index.docker.io/gabrielmirandat/permissions",
)
