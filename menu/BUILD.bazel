# Menu Go service - hermetic build with rules_go
exports_files(["go.mod", "go.sum"])

load("@rules_go//go:def.bzl", "go_binary")
load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

# Alias: main binary (for root BUILD global_artifact / global_uber)
go_binary(
    name = "artifact",
    embed = ["//menu/cmd/server:server_lib"],
    visibility = ["//visibility:public"],
)

go_binary(
    name = "uber",
    embed = ["//menu/cmd/server:server_lib"],
    visibility = ["//visibility:public"],
)

# Tar layer: binary at menu/menu for OCI image
genrule(
    name = "layer",
    srcs = [":uber"],
    outs = ["layer.tar"],
    cmd = """
        set -e
        mkdir -p menu
        cp $(location :uber) menu/menu
        tar cf $@ menu
    """,
)

oci_image(
    name = "image",
    base = "@debian_12_slim",
    entrypoint = ["/menu/menu"],
    tars = [":layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "index.docker.io/gabrielmirandat/menu",
)

# Test suites (same names as permissions/orders for pipeline)
test_suite(
    name = "unit",
    tests = ["//menu/internal/domain:domain_test"],
)

# Placeholder so "bazel test //menu:integration" succeeds (no Go integration tests yet)
sh_test(
    name = "integration_placeholder",
    srcs = ["integration_placeholder.sh"],
    visibility = ["//visibility:private"],
)

test_suite(
    name = "integration",
    tests = [":integration_placeholder"],
)
