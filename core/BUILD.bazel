# core/BUILD

load("@contrib_rules_jvm//java:defs.bzl", "JUNIT5_DEPS", "java_test_suite")
load("@io_grpc_grpc_java//:java_grpc_library.bzl", "java_grpc_library")
load("@rules_java//java:defs.bzl", "java_library", "java_proto_library")
load("@rules_jvm_external//:defs.bzl", "artifact")
load("@rules_proto//proto:defs.bzl", "proto_library")

proto_library(
    name = "model_proto",
    srcs = glob(["model/*.proto"]),
    deps = [
        "@com_google_protobuf//:timestamp_proto",
        "@buf_validate//proto/protovalidate/buf/validate:validate_proto",
    ],
)

java_proto_library(
    name = "model_java_proto",
    visibility = ["//visibility:public"],
    deps = [":model_proto"],
)

genrule(
    name = "model_java_jar",
    srcs = [":model_java_proto"],
    outs = ["model_java_proto.srcjar"],
    cmd = "cp $(RULEDIR)/model_proto-speed-src.jar $(location model_java_proto.srcjar)",
)

proto_library(
    name = "menu_proto",
    srcs = ["specs/menu-api.proto"],
    deps = [
        "@com_google_protobuf//:timestamp_proto",
    ],
)

java_proto_library(
    name = "menu_java_proto",
    visibility = ["//visibility:public"],
    deps = [":menu_proto"],
)

java_grpc_library(
    name = "menu_java_grpc",
    srcs = [":menu_proto"],
    visibility = ["//visibility:public"],
    deps = [":menu_java_proto"],
)

proto_library(
    name = "permissions_proto",
    srcs = ["specs/permissions-api.proto"],
    deps = [
        "@com_google_protobuf//:timestamp_proto",
    ],
)

java_proto_library(
    name = "permissions_java_proto",
    visibility = ["//visibility:public"],
    deps = [":permissions_proto"],
)

java_grpc_library(
    name = "permissions_java_grpc",
    srcs = [":permissions_proto"],
    visibility = ["//visibility:public"],
    deps = [":permissions_java_proto"],
)

java_library(
    name = "model_lib",
    srcs = [":model_java_proto.srcjar"],
    javacopts = [
        "-source",
        "21",
        "-target",
        "21",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:com_google_protobuf_protobuf_java",
        "@maven//:build_buf_protovalidate",
    ],
)

java_test_suite(
    name = "unit",
    srcs = glob(["src/test/java/**/*.java"]),
    javacopts = [
        "-source",
        "21",
        "-target",
        "21",
    ],
    runner = "junit5",
    runtime_deps = JUNIT5_DEPS,
    deps = [
        ":model_lib",
        "@maven//:org_assertj_assertj_core",
        "@maven//:org_glassfish_expressly_expressly",
        "@maven//:org_hibernate_validator_hibernate_validator_cdi",
        "@maven//:org_junit_jupiter_junit_jupiter_api",
    ],
)
