oci_image(
    name = "image",
    base = "@amazon_corretto_image",
    entrypoint = [
        "java",
        "-jar",
        "-Dquarkus.profile=prod",
        "menu/uber.jar",
    ],
    tars = [":layer"],
)

oci_push(
    name = "push",
    image = ":image",
    remote_tags = ["latest"],
    repository = "index.docker.io/gabrielmirandat/menu",
)
