# Payments module BUILD file for Bazel
# Note: .NET support in Bazel - using dotnet CLI wrapper
# For full .NET support, consider using rules_dotnet or building via Docker

load("@aspect_bazel_lib//lib:tar.bzl", "tar")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_push")

package(default_visibility = ["//visibility:public"])

# Build .NET solution using Dockerfile
# Note: .NET builds are done via Dockerfile, not genrule, to avoid sandbox issues
# The actual build happens when building the Docker image
genrule(
    name = "artifact",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
        "**/*.sln",
        "**/*.json",
        "**/*.proto",
        "Dockerfile",
    ], exclude = [
        "**/bin/**",
        "**/obj/**",
        "**/TestResults/**",
    ]),
    outs = ["artifact_marker"],
    cmd = """
        echo "Build marker for payments module" > $@
        echo "Actual build happens via Dockerfile when building :uber target"
    """,
    local = 1,
)

# Unit tests - using genrule with local=1 to allow dotnet access to filesystem
genrule(
    name = "unit",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
        "**/*.sln",
    ], exclude = [
        "**/bin/**",
        "**/obj/**",
        "**/TestResults/**",
    ]),
    outs = ["unit_test_results"],
    cmd = """
        cd $$(dirname $(location Payments.sln))
        dotnet test Payments.sln --verbosity normal || exit 1
        echo "Unit tests completed" > $@
    """,
    testonly = True,
    local = 1,
)

# Integration tests - using genrule with local=1 to allow dotnet access to filesystem
genrule(
    name = "integration",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
        "**/*.sln",
    ], exclude = [
        "**/bin/**",
        "**/obj/**",
        "**/TestResults/**",
    ]),
    outs = ["integration_test_results"],
    cmd = """
        cd $$(dirname $(location Payments.sln))
        dotnet test Payments.sln --verbosity normal || exit 1
        echo "Integration tests completed" > $@
    """,
    testonly = True,
    local = 1,
)

# Executable - ready to run (Docker image)
# Uses Dockerfile for build (similar to how Java modules use springboot rule)
# The Dockerfile handles the dotnet build internally
oci_image(
    name = "uber",
    base = "@dotnet_aspnet_8_0",
    entrypoint = [
        "dotnet",
        "Payments.Api/bin/Release/net8.0/Payments.Api.dll",
    ],
    tars = [":layer"],
)

# Build artifacts will be created by Dockerfile
# For now, we'll use the Dockerfile directly in the image build
# The layer will contain the built DLLs from the Dockerfile build
tar(
    name = "layer",
    srcs = glob([
        "**/*.cs",
        "**/*.csproj",
        "**/*.sln",
        "**/*.json",
        "Dockerfile",
    ], exclude = [
        "**/bin/**",
        "**/obj/**",
        "**/TestResults/**",
    ]),
)

oci_push(
    name = "push",
    image = ":uber",
    repository = "index.docker.io/gabrielmirandat/payments",
    remote_tags = ["latest"],
)
